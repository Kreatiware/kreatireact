{
  "name": "@kreatiware/layout",
  "version": "1.1.0",
  "description": "Sistema de utilities CSS: Flex, Grid, Spacing y Tipografia",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "bin": {
    "kreati-layout": "./bin/kreati-layout.js"
  },
  "exports": {
    ".": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./dist/unprefixed.css": "./dist/unprefixed.css",
    "./unprefixed": "./dist/unprefixed.css"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "bin"
  ],
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && postcss src/index.css -o dist/index.css && node scripts/generate-unprefixed.js",
    "dev": "postcss src/index.css -o dist/index.css --watch",
    "test": "echo \"No tests for CSS utilities\"",
    "clean": "rimraf dist"
  },
  "keywords": [
    "css",
    "flex",
    "grid",
    "layout",
    "utilities",
    "responsive",
    "kreati"
  ],
  "author": "Brian - Kreatiware",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.1",
    "postcss-nesting": "^12.0.2",
    "rimraf": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kreatiware/kreatireact.git",
    "directory": "packages/layout"
  },
  "homepage": "https://kreatiware.com",
  "bugs": "https://github.com/kreatiware/kreatireact/issues",
  "publishConfig": {
    "access": "public"
  }
}
