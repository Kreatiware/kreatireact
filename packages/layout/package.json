{
  "name": "@kreatiware/layout",
  "version": "0.4.1",
  "description": "Sistema de utilities CSS: Flex, Grid, Spacing y Tipografia",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && postcss src/index.css -o dist/index.css",
    "dev": "postcss src/index.css -o dist/index.css --watch",
    "test": "echo \"No tests for CSS utilities\"",
    "clean": "rimraf dist"
  },
  "keywords": [
    "css",
    "flex",
    "grid",
    "layout",
    "utilities",
    "responsive",
    "kreati"
  ],
  "author": "Brian - Kreatiware",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.1",
    "postcss-nesting": "^12.0.2",
    "rimraf": "^5.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}